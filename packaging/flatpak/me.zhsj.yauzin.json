{
  "app-id": "me.zhsj.yauzin",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.golang"
  ],
  "command": "yauzin",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "modules": [
    {
      "name": "yauzin",
      "buildsystem": "simple",
      "build-options": {
        "build-args": [
          "--share=network"
        ],
        "prepend-path": "/usr/lib/sdk/golang/bin",
        "env": {
          "GOTOOLCHAIN": "local"
        }
      },
      "build-commands": [
        "go build -trimpath -buildmode=pie -ldflags=\"-s -w\" -o yauzin ./cmd/yauzin",
        "install -Dm755 yauzin /app/bin/yauzin",
        "install -Dm644 packaging/flatpak/me.zhsj.yauzin.desktop /app/share/applications/me.zhsj.yauzin.desktop",
        "install -Dm644 packaging/flatpak/me.zhsj.yauzin.metainfo.xml /app/share/metainfo/me.zhsj.yauzin.metainfo.xml",
        "install -Dm644 artwork/icon-red-512.png /app/share/icons/hicolor/512x512/apps/me.zhsj.yauzin.png",
        "install -Dm644 LICENSE /app/share/licenses/me.zhsj.yauzin/LICENSE"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
